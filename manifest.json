{
  "manifest_version": 3,
  "name": "Handdy — Hand Gesture Mouse & Browser Controller",
  "short_name": "Handdy",
  "version": "1.2.1",
  "description": "Live hand-tracked mouse pointer across all Chrome tabs: point, click, drag, scroll, switch tabs, zoom, and control media with hand gestures.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel",
    "sessions"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Handdy — Hand Gesture Control",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "permission.html",
  "commands": {
    "toggle-hand-tracking": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "Toggle Handdy Gesture Control On/Off"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "camera_frame.html",
        "camera_frame.js",
        "gesture_engine.js",
        "permission.html",
        "lib/mediapipe/*",
        "models/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
